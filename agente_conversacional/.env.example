# Backend de LLM ativo: "ollama" (local) ou "claude" (hospedado, ver ticket 0.3)
LLM_BACKEND=ollama

# Ollama local (ticket 0.1/0.2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Tuning de VRAM/velocidade do Ollama (opcional). Se o modelo nao couber
# inteiro na GPU, `ollama ps` mostra offload parcial pra CPU (ex.: "14%/86%
# CPU/GPU") e a resposta fica bem mais lenta. Baixar OLLAMA_NUM_CTX reduz o
# KV cache e costuma resolver sem trocar de modelo nem perder qualidade.
# OLLAMA_NUM_CTX=2048
# OLLAMA_NUM_PREDICT=512

# Backend hospedado alternativo (ticket 0.3) — só necessario se LLM_BACKEND=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Timeout padrao (segundos) das chamadas ao LLM
LLM_TIMEOUT_SECONDS=8

# Sessoes de chat (ticket KAN-8) — persistidas em SQLite pra sobreviver a
# um restart do servidor (deploy, crash, reiniciar em dev). Sem isso o
# frontend "descarrega" a conversa a cada restart (session_id do navegador
# vira invalido pro backend).
SESSION_DB_PATH=sessions.db
SESSION_TIMEOUT_MINUTES=30

# Integracao Spotify OAuth (ticket 5.1) — registrar o app em
# https://developer.spotify.com/dashboard. Nao ha SPOTIFY_REDIRECT_URI aqui
# (ticket KAN-169): o backend calcula o redirect_uri sozinho a partir do
# Host/scheme de quem bateu em /auth/login/start, entao varios dominios
# funcionam ao mesmo tempo (ex.: https://seuhost.local:8010/auth/callback
# pra rede local + https://algo.trycloudflare.com/auth/callback pra acesso
# externo) — so cadastra CADA URI usado no dashboard, exatamente igual ao
# que aparece na barra de enderecos + "/auth/callback".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Chave de criptografia dos tokens em repouso (ticket 5.4) — gerar com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SPOTIFY_TOKEN_ENCRYPTION_KEY=
SPOTIFY_TOKEN_DB_PATH=spotify_tokens.db

# Origem(ns) do frontend liberada(s) no CORS (ticket 8.2), separadas por
# virgula se houver mais de uma (ex.: dev + demo)
FRONTEND_URL=http://127.0.0.1:5173

# Rate limiting do /chat (ticket 8.4) — ainda sem endpoint pra aplicar,
# mas ja configuravel pra quando POST /chat (ticket 3.2) existir
CHAT_RATE_LIMIT_MAX_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# Previa de audio via YouTube (ticket 13.12 / KAN-121) — fallback usado
# quando GET /explorer/track/{id} nao devolve preview_url (comum pra apps
# Spotify criados apos nov/2024). Gerar em
# https://console.cloud.google.com/apis/credentials (ativar "YouTube Data
# API v3" no projeto antes). Sem esta chave, GET /youtube/preview sempre
# devolve video_id null e o fallback simplesmente nao funciona.
YOUTUBE_API_KEY=
