# Backend de LLM ativo: "ollama" (local) ou "claude" (hospedado, ver ticket 0.3)
LLM_BACKEND=ollama

# Ollama local (ticket 0.1/0.2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Backend hospedado alternativo (ticket 0.3) — só necessario se LLM_BACKEND=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Timeout padrao (segundos) das chamadas ao LLM
LLM_TIMEOUT_SECONDS=8

# Integracao Spotify OAuth (ticket 5.1) — registrar o app em
# https://developer.spotify.com/dashboard e usar a mesma redirect_uri aqui
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/callback

# Chave de criptografia dos tokens em repouso (ticket 5.4) — gerar com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SPOTIFY_TOKEN_ENCRYPTION_KEY=
SPOTIFY_TOKEN_DB_PATH=spotify_tokens.db
