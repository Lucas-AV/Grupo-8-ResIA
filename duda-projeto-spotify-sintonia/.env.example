# Spotify Web API — preencha somente no arquivo .env local.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback
SPOTIFY_MODO=demo
SPOTIFY_URL_FRONTEND=http://127.0.0.1:3000
SPOTIFY_TIMEOUT_SEGUNDOS=10
SPOTIFY_MAX_TENTATIVAS=3
SPOTIFY_COOKIE_SECURE=false

# LLM usado pelo Orquestrador/Conversacional.
OPENAI_API_KEY=

# Regra obrigatória: abaixo de 0.90, encaminhar para revisão humana.
LIMIAR_CONFIANCA=0.90
CHAVE_REVISAO_HUMANA=

# Persistência local da demonstração acadêmica.
CAMINHO_BANCO_SQLITE=./dados/sistema/spotify_insights.db
AMBIENTE=desenvolvimento

# URL pública consumida pelo frontend. Não coloque segredos em NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
